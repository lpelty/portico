#!/usr/bin/env bash
# Move this checkout to the newest release tag (vX.Y.Z), then bin/install (prerequisites, gateway, the app
# rebuilt with a working macOS SDK and reinstalled as <brand.name>.app), then the doctor.
#   bin/update                  newest release tag (the default)
#   bin/update --channel main   follow main instead: fast-forward pull
# A gateway still running the old version is stopped once the checkout has moved (before the install);
# the app starts the new one.
# Refuses to update over local changes: deployment code belongs in a plug-in, outside the checkout.
set -euo pipefail

usage() {
  echo "usage: bin/update [--channel tags|main]" >&2
}

# Stops a gateway running on this machine's state directory, if one runs; says so only then.
# `portico-gateway stop` exits 0 when it stopped one, 3 when none ran, anything else on trouble.
stop_running_gateway() {
  local here="$1" rc=0
  "$here/portico-gateway" stop >/dev/null 2>&1 || rc=$?
  case "$rc" in
    0) echo "Stopped the running gateway (it was the old version); Portico starts the new one." ;;
    3) ;;
    *) echo "update: could not stop the running gateway (portico-gateway stop exited $rc); quit Portico before using it" >&2 ;;
  esac
}

main() {
  local here repo channel
  here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  repo="$(dirname "$here")"
  channel="tags"
  while [ $# -gt 0 ]; do
    case "$1" in
      --channel) channel="${2:-}"; shift 2 || { usage; exit 2; } ;;
      --channel=*) channel="${1#--channel=}"; shift ;;
      -h|--help) usage; exit 0 ;;
      *) usage; exit 2 ;;
    esac
  done
  case "$channel" in
    tags|main) ;;
    *) echo "update: unknown channel '$channel' (tags or main)" >&2; exit 2 ;;
  esac
  cd "$repo"

  if [ -n "$(git status --porcelain)" ]; then
    echo "update: this checkout has local changes:" >&2
    git status --short >&2
    echo "update: not updating over them. Move the change into a plug-in (README, \"Plug-ins\"), outside this" >&2
    echo "update: checkout, or ask upstream for it; run bin/update again once the checkout is clean." >&2
    exit 1
  fi

  if [ "$channel" = "main" ]; then
    echo "== update: following main"
    if [ "$(git rev-parse --abbrev-ref HEAD)" != "main" ]; then
      git -c advice.detachedHead=false checkout --quiet main
    fi
    git pull --ff-only
  else
    echo "== update: fetching release tags"
    git fetch --quiet --tags origin
    local newest current
    newest="$(git tag -l 'v*' --sort=-v:refname | grep -E '^v[0-9]+\.[0-9]+\.[0-9]+$' | head -n 1 || true)"
    if [ -z "$newest" ]; then
      echo "update: no release tags (vX.Y.Z) found; try bin/update --channel main" >&2
      exit 1
    fi
    current="$(git describe --tags --exact-match HEAD 2>/dev/null || true)"
    if [ "$current" = "$newest" ]; then
      echo "== update: already on $newest; nothing to install"
      exec "$here/doctor"
    fi
    echo "== update: ${current:-$(git rev-parse --short HEAD)} -> $newest"
    git -c advice.detachedHead=false checkout --quiet "$newest"
  fi

  stop_running_gateway "$here"
  "$here/install"
  echo
  echo "== update: doctor"
  exec "$here/doctor"
}

# The whole script is read before it runs: a checkout that rewrites this
# file mid-update cannot change what the running copy does next.
main "$@"
exit
