#!/usr/bin/env bash
# One command from a fresh clone: prerequisites checked, the gateway's venv (uv), the app's
# release build (swift, with a macOS SDK that compiles it), and <brand.name>.app in ~/Applications.
#
#   bin/install                 Portico's folder (config, token, index, log) as found below
#   bin/install --home DIR      keep it in DIR (made if missing, mode 0700, and so is any missing
#                               folder above it): written into the app's Info.plist (PorticoHome)
#                               and, once the install succeeds, into this checkout's git-ignored
#                               .portico-home
#
# The folder, in order: --home; $PORTICO_HOME; the folder .portico-home names; the CLI's
# default (~/.portico). It is written into the app only for --home, or when .portico-home
# exists (a checkout installed with --home; then $PORTICO_HOME, which the app's updater
# exports, is written if set, unless PORTICO_HOME_SOURCE says it is only the default). A generic install bakes nothing.
#
# Environment:
#   PORTICO_APP_DIR   where the .app goes (default: ~/Applications)
#   PORTICO_HOME      Portico's folder when there is no --home (not written into the app)
#   PORTICO_SDKROOT   build the app with this macOS SDK only (see app/Packaging/build-app.sh)
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
repo="$(dirname "$here")"
packaging="$repo/app/Packaging"
home_file="$repo/.portico-home"

# One spelling of a folder: ~/ expanded, a relative path made absolute, trailing slashes dropped.
normalize_folder() {
  local p="$1"
  case "$p" in "~/"*) p="$HOME/${p#\~/}" ;; "~") p="$HOME" ;; esac
  case "$p" in /*) ;; *) p="$PWD/$p" ;; esac
  while [ "${#p}" -gt 1 ] && [ "${p%/}" != "$p" ]; do p="${p%/}"; done
  printf '%s\n' "$p"
}

usage() {
  echo "usage: bin/install [--home DIR]   (DIR: Portico's folder; missing folders are made with mode 0700)" >&2
}

home_arg=""
while [ $# -gt 0 ]; do
  case "$1" in
    --home) [ $# -ge 2 ] && [ -n "$2" ] || { usage; exit 2; }; home_arg="$2"; shift 2 ;;
    --home=?*) home_arg="${1#--home=}"; shift ;;
    -h|--help) usage; exit 0 ;;
    *) usage; exit 2 ;;
  esac
done
if [ -n "$home_arg" ]; then
  home_arg="$(normalize_folder "$home_arg")"
  if [ -e "$home_arg" ] && [ ! -d "$home_arg" ]; then
    echo "install: --home $home_arg is a file, not a folder" >&2
    exit 2
  fi
fi

echo "== prerequisites"
if ! "$packaging/prereqs.sh" "$repo"; then
  echo "install: a prerequisite is missing (FAIL above); nothing was installed" >&2
  exit 1
fi

echo "== gateway: uv sync"
(cd "$repo/gateway" && uv sync --quiet)

# Portico's folder. `bake` is set when it goes into the app's Info.plist.
home="" bake=""
home_file_folder=""
if [ -f "$home_file" ]; then
  home_file_folder="$(head -n 1 "$home_file" | tr -d '\r')"
  [ -z "$home_file_folder" ] || home_file_folder="$(normalize_folder "$home_file_folder")"
fi
# The app and the gateway export PORTICO_HOME even when they fell back to the default folder
# (PORTICO_HOME_SOURCE says "the default"): that is not a choice, so .portico-home still counts.
env_home="${PORTICO_HOME:-}"
[ "${PORTICO_HOME_SOURCE:-}" != "the default" ] || env_home=""
[ -z "$env_home" ] || env_home="$(normalize_folder "$env_home")"
if [ -n "$home_arg" ]; then
  if [ ! -d "$home_arg" ]; then
    (umask 077 && mkdir -p "$home_arg")
    chmod 700 "$home_arg"
  fi
  home="$(CDPATH='' cd "$home_arg" && pwd)"
  bake=1
elif [ -n "$env_home" ]; then
  home="$env_home"
  # The app's updater exports PORTICO_HOME with PORTICO_HOME_SOURCE=Info.plist: the app's own
  # folder, a choice to keep even when this checkout has no .portico-home (a re-clone, git clean).
  # A checkout installed with --home keeps its folder in the app as well. A plain shell export
  # with no such hint is used for this install and not baked in.
  case "${PORTICO_HOME_SOURCE:-}" in "Info.plist"|".portico-home") bake=1 ;; esac
  if [ -n "$home_file_folder" ]; then
    bake=1
    if [ "$home" != "$home_file_folder" ]; then
      echo "install: PORTICO_HOME ($home) differs from .portico-home ($home_file_folder); the app keeps PORTICO_HOME" >&2
    fi
  fi
elif [ -n "$home_file_folder" ]; then
  home="$home_file_folder"
  bake=1
fi
# A remembered folder that has gone is not made again here (the gateway would make it, empty).
if [ -n "$bake" ] && [ -z "$home_arg" ] && [ ! -d "$home" ]; then
  echo "install: Portico's folder $home is missing; reinstall with --home $home" >&2
  exit 1
fi
state_args=() home_args=()
[ -z "$home" ] || state_args=(--state "$home")
[ -z "$bake" ] || home_args=(--home "$home")

# Brand name and icons from the deployment's config; Portico's own when a key is unset. A config
# that does not load stops the install here, before the build: a default-branded app would hide it.
cli="$repo/gateway/.venv/bin/portico-gateway"
if ! reason="$("$cli" config-value brand.name ${state_args[@]+"${state_args[@]}"} 2>&1 >/dev/null)"; then
  printf '%s\n' "${reason:-portico-gateway config-value failed}" >&2
  echo "install: the config above does not load; fix it and run bin/install again (nothing was installed)" >&2
  exit 1
fi
config_value() { # prints the value, or nothing when unset
  "$cli" config-value "$1" ${state_args[@]+"${state_args[@]}"} | head -n 1
}
name="$(config_value brand.name)"
name="${name:-Portico}"
icon="$(config_value brand.app_icon)"
case "$icon" in "~/"*) icon="$HOME/${icon#\~/}" ;; esac
if [ -n "$icon" ] && [ ! -f "$icon" ]; then
  echo "install: brand.app_icon is $icon, which does not exist; using the default icon" >&2
  icon=""
fi
icon="${icon:-$packaging/AppIcon.png}"
# A precompiled asset catalog (Icon Composer, actool) for macOS 26's icon look; the .icns stays.
icon_assets="$(config_value brand.app_icon_assets)"
icon_name="$(config_value brand.app_icon_name)"
icon_args=()
if [ -n "$icon_assets" ] || [ -n "$icon_name" ]; then
  if [ -z "$icon_assets" ] || [ -z "$icon_name" ]; then
    echo "install: brand.app_icon_assets and brand.app_icon_name go together; only the PNG icon is used" >&2
  elif [ ! -f "$icon_assets" ]; then
    echo "install: brand.app_icon_assets is $icon_assets, which does not exist; only the PNG icon is used" >&2
  else
    icon_args=(--icon-assets "$icon_assets" --icon-name "$icon_name")
  fi
fi

products="$("$packaging/build-app.sh" "$repo" | tail -n 1)"

min_macos="$(sed -n 's/.*\.macOS(\.v\([0-9][0-9]*\)).*/\1/p' "$repo/app/Package.swift" | head -n 1)"
min_macos="${min_macos:-15}.0"
version="$(tr -d '[:space:]' <"$repo/VERSION")"
app_dir="${PORTICO_APP_DIR:-$HOME/Applications}"

echo "== app: $name.app"
app="$("$packaging/make-app.sh" \
  --products "$products" \
  --dest "$app_dir" \
  --name "$name" \
  --icon "$icon" \
  --version "$version" \
  --gateway-bin "$repo/bin/portico-gateway" \
  --min-macos "$min_macos" \
  ${icon_args[@]+"${icon_args[@]}"} \
  ${home_args[@]+"${home_args[@]}"} | tail -n 1)"

# Keep .portico-home in step with what the app now carries, so a later terminal bin/update
# does not flip back to an older folder.
if [ -n "$bake" ] && [ "$home" != "$home_file_folder" ]; then
  printf '%s\n' "$home" >"$home_file"
fi

echo
echo "Installed: $app"
echo "Folder:    ${home:-the default (bin/doctor names it)}"
if [ -z "${PORTICO_APP_DIR:-}" ]; then
  echo "Open it:   open \"$app\"   (or Finder: your home folder, Applications)"
else
  echo "Open it:   open \"$app\""
fi
echo "Gateway:   $repo/bin/portico-gateway run"
