#!/usr/bin/env bash
# Run the gateway from a fresh clone: load the deployment's env file (if any), then the installed CLI.
#
# ${PORTICO_HOME:-$HOME/.portico}/env is an optional 0600 file of KEY=value lines the deployment
# fills with its provider credential. The repo never names a provider; the engine reads the
# environment. Everything after the script name goes to portico-gateway (run, doctor, ...).
set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
repo="$(dirname "$here")"
home="${PORTICO_HOME:-$HOME/.portico}"
env_file="$home/env"

if [ -f "$env_file" ]; then
  # The file is sourced, so a line that is not KEY=value would run as a
  # command (and, under errexit, kill this script before bin/doctor could
  # diagnose it). Lines that are plainly not assignments are found first
  # without running anything; then the file is not loaded and the doctor
  # names the line. Nothing from the file is ever echoed.
  bad="$(grep -nEv '^[[:space:]]*(#|$)|^[[:space:]]*(export[[:space:]]+)?[A-Za-z_][A-Za-z0-9_]*=' "$env_file" | cut -d: -f1 | head -3 | tr '\n' ' ' || true)"
  bad="${bad% }"
  if [ -n "$bad" ]; then
    echo "portico-gateway: $env_file not loaded: line(s) $bad are not KEY=value; run $repo/bin/doctor" >&2
  else
    set -a
    set +e
    # shellcheck disable=SC1090
    . "$env_file" 2>/dev/null
    set -e
    set +a
  fi
fi

cli="$repo/gateway/.venv/bin/portico-gateway"
if [ ! -x "$cli" ]; then
  echo "portico-gateway: $cli is missing; run $repo/bin/install first" >&2
  exit 1
fi

exec "$cli" "$@"
