#!/usr/bin/env bash
# Run the gateway from a fresh clone: the installed CLI, nothing else.
#
# ${PORTICO_HOME:-$HOME/.portico}/env is an optional 0600 file of KEY=value lines the
# deployment fills with its provider credential. The CLI reads it itself (literal
# values, no shell, no expansion) for `run` and `doctor`; this script never sources
# it. The repo never names a provider; the engine reads the environment. Everything
# after the script name goes to portico-gateway (run, doctor, check-env, ...).
set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
repo="$(dirname "$here")"

cli="$repo/gateway/.venv/bin/portico-gateway"
if [ ! -x "$cli" ]; then
  echo "portico-gateway: $cli is missing; run $repo/bin/install first" >&2
  exit 1
fi

exec "$cli" "$@"
